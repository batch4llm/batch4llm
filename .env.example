# Copy this file to .env and fill in your values before running docker compose up
# .env is gitignored and must never be committed

# Image version to run, e.g. v0.1.0. Pin a release on servers; to update,
# change it here and run `docker compose pull && docker compose up -d`.
BATCH4LLM_VERSION=latest

# PostgreSQL
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=batch4llm

# Redis
REDIS_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me

# Internal connection settings for backend, worker and beat.
# Derived from the values above — normally no need to change anything here.
# Note: passwords end up in URLs, so avoid characters like @ : / in them.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=llm-files
MINIO_SECURE=false

# Domain & TLS (only required for the production setup, compose.prod.yaml)
DOMAIN=change_me
ACME_EMAIL=change_me

# Bootstrap admin account (optional)
# If both are set, an admin account with these credentials is created
# automatically on first startup. Later restarts never touch an existing
# account (password changes made afterwards, e.g. via the UI, are not
# overwritten). Leave both commented out to skip this and create the first
# admin manually via `docker compose exec backend b4llm user create <username> <password> --admin`.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me
