# Copy this file to .env and fill in your values before running docker compose up
# .env is gitignored and must never be committed

# PostgreSQL
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=batch4llm

# Redis
REDIS_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me

# Domain & TLS (only required for compose.prod.yaml)
DOMAIN=change_me
ACME_EMAIL=change_me

# Bootstrap admin account (optional)
# If both are set, an admin account with these credentials is created
# automatically on first startup. Later restarts never touch an existing
# account (password changes made afterwards, e.g. via the UI, are not
# overwritten). Leave both commented out to skip this and create the first
# admin manually via `docker compose exec backend b4llm user create <username> <password> --admin`.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me
