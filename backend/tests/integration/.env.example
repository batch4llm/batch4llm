# Copy to .env in this folder to run the real_api-marked tests locally.
# This file is gitignored and must never be committed.
#
# Every key is optional — tests for a provider whose key is missing are
# skipped automatically. Only fill in the providers you want to check.
# These are real provider API keys and calls here cost real money, so keep
# amounts small (the tests already use cheap models and short prompts).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
